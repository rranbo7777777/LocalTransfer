<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ 调色板 -->
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F4F6FA" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#17233C" />
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#273B63" />
    <SolidColorBrush x:Key="AccentBrush" Color="#356AE6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F9FBFF" />
    <SolidColorBrush x:Key="AccentOutlineBrush" Color="#9CB3E8" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E1E5ED" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#17233C" />
    <SolidColorBrush x:Key="TextStrongBrush" Color="#303A4D" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#69758C" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9AA4B6" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#8A94A6" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E9E62" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E5A50A" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF5DC" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#8A610E" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#E4F6EC" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#0F6B40" />
    <SolidColorBrush x:Key="NeutralSurfaceBrush" Color="#EEF1F7" />
    <SolidColorBrush x:Key="TrackBrush" Color="#E3E9F5" />

    <!-- ============================================================ 侧边导航 -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="12,3" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="#DCE4F5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#1F2E4D" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 兼容旧命名，行为与 NavButton 一致 -->
    <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource NavButton}" />

    <!-- ============================================================ 按钮 -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{StaticResource AccentBrush}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#2A57C4" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="#B9C6E4" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Foreground" Value="#3D4A61" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#CFD6E4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#F2F5FB" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 无边框文字按钮，用于「清空」「移除」这类次级操作 -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#67748A" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="DangerGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>

    <!-- ============================================================ 容器 -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- ============================================================ 文本 -->
    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="PageSubtitleText" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,7,0,0" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- 列表为空时居中显示的占位文字 -->
    <Style x:Key="EmptyStateText" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <!-- ============================================================ 其它 -->
    <Style x:Key="ThinProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{StaticResource TrackBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

</ResourceDictionary>
