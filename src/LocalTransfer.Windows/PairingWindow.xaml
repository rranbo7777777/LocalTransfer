<Window x:Class="LocalTransfer.Windows.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手机安全配对"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackgroundBrush}">
    <Grid Margin="28,26,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold"
                   Foreground="#17233C" Text="扫描二维码配对" />
        <TextBlock Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Center"
                   Foreground="#69758C"
                   Text="二维码包含一次性密钥。手机扫码后，请在电脑上尽快确认。" />

        <Border Grid.Row="2" Margin="0,20,0,0" Padding="16" HorizontalAlignment="Center"
                Background="White" BorderBrush="#D8DEEA" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <Image x:Name="QrImage" Width="300" Height="300" Stretch="Uniform" />
                <DockPanel Margin="0,14,0,0" Width="300">
                    <TextBlock x:Name="CountdownText" DockPanel.Dock="Right" FontWeight="SemiBold"
                               Foreground="#356AE6" Text="--:--" />
                    <TextBlock Foreground="#69758C" Text="剩余有效时间" />
                </DockPanel>
                <ProgressBar x:Name="CountdownBar" Margin="0,8,0,0" Width="300" Value="1"
                             Style="{StaticResource ThinProgress}" Minimum="0" Maximum="1" />
                <TextBlock x:Name="ExpiryHintText" Margin="0,10,0,0" Width="300" FontSize="12"
                           TextWrapping="Wrap" Foreground="#8A94A6"
                           Text="手机扫码后会进入等待确认状态；请尽快在弹出的窗口里点「信任此设备」。" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,18,0,0" Padding="16" Background="White"
                BorderBrush="#E1E5ED" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="局域网地址" />
                <TextBlock x:Name="EndpointText" Margin="0,5,0,0" Foreground="#526078" />
                <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="证书 SHA-256 指纹" />
                <TextBlock x:Name="FingerprintText" Margin="0,5,0,0" Foreground="#526078"
                           FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Margin="0,14,0,0" Foreground="#8A610E" TextWrapping="Wrap"
                   Text="仅在手机与电脑连接同一 Wi-Fi 或手机热点时使用。手机首次连接会固定本机证书指纹，电脑仍需确认设备名称。" />

        <StackPanel Grid.Row="5" Margin="0,18,0,0" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CopyButton" MinWidth="150" Click="OnCopyClicked"
                    Style="{StaticResource SecondaryButton}" Content="复制配对信息" />
            <Button MinWidth="96" Margin="10,0,0,0" IsDefault="True" Click="OnCloseClicked"
                    Style="{StaticResource PrimaryButton}" Content="关闭" />
        </StackPanel>
    </Grid>
</Window>
