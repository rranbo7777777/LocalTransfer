<Window x:Class="LocalTransfer.Windows.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手机安全配对"
        Width="540"
        Height="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold"
                   Foreground="#17233C" Text="扫描二维码配对" />
        <TextBlock Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Center"
                   Foreground="#69758C" Text="二维码包含一次性密钥，2 分钟后失效" />

        <Border Grid.Row="2" Margin="0,20,0,0" Padding="16" HorizontalAlignment="Center"
                Background="White" BorderBrush="#D8DEEA" BorderThickness="1" CornerRadius="8">
            <Image x:Name="QrImage" Width="300" Height="300" Stretch="Uniform" />
        </Border>

        <Border Grid.Row="3" Margin="0,18,0,0" Padding="16" Background="White"
                BorderBrush="#E1E5ED" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="局域网地址" />
                <TextBlock x:Name="EndpointText" Margin="0,5,0,0" Foreground="#526078" />
                <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="证书 SHA-256 指纹" />
                <TextBlock x:Name="FingerprintText" Margin="0,5,0,0" Foreground="#526078"
                           FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Margin="0,14,0,0" Foreground="#8A610E" TextWrapping="Wrap"
                   Text="仅在手机与电脑连接同一 Wi-Fi 或手机热点时使用。手机首次连接时会固定本机证书指纹，电脑仍需确认设备名称。" />

        <StackPanel Grid.Row="5" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="150" Height="38" Margin="0,0,10,0" Click="OnCopyClicked"
                    Content="复制配对信息" />
            <Button Width="90" Height="38" IsDefault="True" Click="OnCloseClicked" Content="关闭" />
        </StackPanel>
    </Grid>
</Window>
