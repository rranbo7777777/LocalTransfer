<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocalTransfer.Mobile.MainPage"
             Title="发送"
             BackgroundColor="{StaticResource LtPageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,30" Spacing="16">

            <!-- ============================================ 标题 + 连接状态 -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="3">
                    <Label Style="{StaticResource LtPageTitle}" Text="局域传输" />
                    <Label Style="{StaticResource LtPageSubtitle}"
                           Text="文件只在当前局域网内传输，不经过服务器" />
                </VerticalStackLayout>
                <Border x:Name="ConnectionStatusPill" Grid.Column="1"
                        Style="{StaticResource LtStatusPill}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Label x:Name="ConnectionStatusLabel"
                           Style="{StaticResource LtStatusPillText}" Text="未连接" />
                </Border>
            </Grid>

            <!-- ============================================ 目标电脑 -->
            <Border Style="{StaticResource LtCard}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Style="{StaticResource LtFieldLabel}" Text="目标电脑" />
                            <Label x:Name="ComputerNameLabel" Style="{StaticResource LtBody}"
                                   FontAttributes="Bold" LineBreakMode="TailTruncation"
                                   Text="尚未配对电脑" />
                            <Label x:Name="ComputerDetailLabel" Style="{StaticResource LtMuted}"
                                   LineBreakMode="TailTruncation"
                                   Text="先在电脑上点「创建配对信息」，再用手机扫描二维码" />
                        </VerticalStackLayout>
                        <Button x:Name="PairButton" Grid.Column="1" VerticalOptions="Center"
                                Style="{StaticResource LtCompactAction}"
                                Clicked="OnPairClicked" Text="配对" />
                    </Grid>

                    <!-- 只在已配对时出现：手机侧也能主动解绑，不必跑到电脑上移除 -->
                    <Button x:Name="UnbindButton" IsVisible="False" HorizontalOptions="End"
                            Style="{StaticResource LtDangerGhostAction}"
                            Clicked="OnUnbindClicked" Text="解除与这台电脑的配对" />
                </VerticalStackLayout>
            </Border>

            <!-- ============================================ 选择文件 -->
            <Border Padding="20" BackgroundColor="{StaticResource LtAccentSoft}"
                    Stroke="{StaticResource LtAccentOutline}" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label HorizontalTextAlignment="Center" FontSize="32"
                           TextColor="{StaticResource LtAccent}" Text="＋" />
                    <Label HorizontalTextAlignment="Center" FontSize="16" FontAttributes="Bold"
                           TextColor="{StaticResource LtTextPrimary}" Text="选择要发送的文件" />
                    <Label HorizontalTextAlignment="Center" Style="{StaticResource LtMuted}"
                           Text="支持多选；在微信 / QQ 里选「分享 → 局域传输」也可以直接带过来" />
                    <Button Margin="0,6,0,0" Padding="26,0"
                            Style="{StaticResource LtCompactAction}"
                            Clicked="OnChooseFilesClicked" Text="选择文件" />
                </VerticalStackLayout>
            </Border>

            <!-- ============================================ 待发送列表 -->
            <Border Style="{StaticResource LtCard}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Style="{StaticResource LtSectionTitle}" Text="待发送文件" />
                        <Label x:Name="SelectedFilesSummary" Grid.Column="1" FontSize="12"
                               VerticalTextAlignment="Center"
                               TextColor="{StaticResource LtTextSecondary}" Text="0 个文件" />
                    </Grid>
                    <Label x:Name="EmptySelectionLabel" Margin="0,16" Text="尚未选择文件"
                           Style="{StaticResource LtEmptyHint}" />
                    <CollectionView x:Name="SelectedFilesView" IsVisible="False" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,8" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <VerticalStackLayout Spacing="2">
                                        <Label LineBreakMode="TailTruncation" FontAttributes="Bold"
                                               TextColor="{StaticResource LtTextStrong}"
                                               Text="{Binding FileName}" />
                                        <Label FontSize="11" TextColor="{StaticResource LtTextMuted}"
                                               Text="{Binding ContentType}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Margin="15,0,0,0" VerticalTextAlignment="Center"
                                           FontSize="12" TextColor="{StaticResource LtTextSecondary}"
                                           Text="{Binding SizeText}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- ============================================ 两个方向分开写清楚 -->
            <VerticalStackLayout Spacing="6">
                <Label Style="{StaticResource LtDirectionLabel}" Text="手机 → 电脑" />
                <Button x:Name="SendButton" IsEnabled="False" Clicked="OnSendClicked"
                        Style="{StaticResource LtPrimaryAction}" Text="连接电脑后发送" />
                <Label Style="{StaticResource LtDirectionLabel}" Margin="4,10,0,5"
                       Text="电脑 → 手机" />
                <Button x:Name="ReceiveButton" IsEnabled="False" Clicked="OnReceiveClicked"
                        Style="{StaticResource LtSecondaryAction}" Text="接收电脑发来的文件" />
            </VerticalStackLayout>

            <!-- ============================================ 进度 -->
            <VerticalStackLayout x:Name="TransferStatusArea" IsVisible="False" Spacing="8">
                <ProgressBar x:Name="TransferProgressBar" Progress="0"
                             Style="{StaticResource LtProgress}" />
                <Label x:Name="TransferStatusLabel" HorizontalTextAlignment="Center"
                       FontSize="12" TextColor="{StaticResource LtTextSecondary}"
                       Text="正在准备…" />
            </VerticalStackLayout>

            <Label HorizontalTextAlignment="Center" Style="{StaticResource LtMuted}"
                   Text="协议版本 1 · 当前为内部开发版本" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
