    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\TestProgram.cs" Link="TestProgram.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LocalTransfer.Contracts\LocalTransfer.Contracts.csproj" />
    <ProjectReference Include="..\..\src\LocalTransfer.Core\LocalTransfer.Core.csproj" />
    <ProjectReference Include="..\..\src\LocalTransfer.Infrastructure\LocalTransfer.Infrastructure.csproj" />
  </ItemGroup>

</Project>
